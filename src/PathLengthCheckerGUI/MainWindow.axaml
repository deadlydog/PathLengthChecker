<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PathLengthCheckerGUI"
        xmlns:PathLengthChecker="clr-namespace:PathLengthChecker;assembly=PathLengthChecker"
        x:Class="PathLengthCheckerGUI.MainWindow"
        MinWidth="770" MinHeight="400"
        Width="900" Height="700"
        Title="Path Length Checker">

    <Window.Styles>
        <!-- GroupBox simulation -->
        <Style Selector="Border.groupBox">
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4,8,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style Selector="TextBlock.groupBoxHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Styles>

    <Grid Margin="5" RowDefinitions="Auto,5,Auto,5,Auto,5,*,5,Auto,5,Auto">

        <!-- Row 0: Path Search Options -->
        <Border Grid.Row="0" Classes="groupBox">
            <StackPanel>
                <TextBlock Classes="groupBoxHeader" Text="Path Search Options"/>

                <!-- Starting Directory row -->
                <Grid ColumnDefinitions="Auto,5,*,40" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Starting Directory:"
                               ToolTip.Tip="The root directory to look for files and/or directories in."
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" x:Name="TxtRootDirectory"
                             Text="{Binding RootDirectory}"
                             ToolTip.Tip="The directory to look for files and/or directories in."/>
                    <Button Grid.Column="3" Content="..."
                            x:Name="BtnBrowseForRootDirectory"
                            Click="BtnBrowseForRootDirectory_Click"
                            ToolTip.Tip="Browse for a folder to search in."/>
                </Grid>

                <!-- Options row -->
                <Grid ColumnDefinitions="Auto,5,120,*,Auto,*,Auto,5,Auto,*,Auto,5,Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Include:" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               ToolTip.Tip="The file system types to find and return the path length of."/>
                    <ComboBox Grid.Column="2" x:Name="CmbTypesToInclude"
                              ItemsSource="{Binding FileSystemTypeOptions}"
                              SelectedItem="{Binding SelectedFileSystemType}"
                              ToolTip.Tip="The file system types to find and return the path length of."/>

                    <CheckBox Grid.Column="4" Content="Include Subdirectories"
                              x:Name="ChkIncludeSubdirectories"
                              IsChecked="{Binding IncludeSubdirectories}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="If enabled it will search for files/directories in all subdirectories of the Starting Directory."/>

                    <TextBlock Grid.Column="6" Margin="0,0,5,0" Text="Min Path Length:" VerticalAlignment="Center">
                        <ToolTip.Tip>
                            <TextBlock>
                                Only paths with this many or more characters will be returned.&#10;Use 260 to identify long paths. Use 0 to not filter by minimum length.
                            </TextBlock>
                        </ToolTip.Tip>
                    </TextBlock>
                    <NumericUpDown Grid.Column="8" x:Name="NumMinPathLength"
                                   Value="{Binding MinPathLength}"
                                   Minimum="0" Maximum="999999" Increment="1"
                                   FormatString="0" MinWidth="70">
                        <ToolTip.Tip>
                            <TextBlock>
                                Only paths with this many or more characters will be returned.&#10;Use 260 to identify long paths. Use 0 to not filter by minimum length.
                            </TextBlock>
                        </ToolTip.Tip>
                    </NumericUpDown>

                    <TextBlock Grid.Column="10" Margin="0,0,5,0" Text="Max Path Length:" VerticalAlignment="Center">
                        <ToolTip.Tip>
                            <TextBlock>
                                Only paths with this many or fewer characters will be returned.&#10;Use 999999 to not filter by maximum length.
                            </TextBlock>
                        </ToolTip.Tip>
                    </TextBlock>
                    <NumericUpDown Grid.Column="12" x:Name="NumMaxPathLength"
                                   Value="{Binding MaxPathLength}"
                                   Minimum="0" Maximum="999999" Increment="1"
                                   FormatString="0" MinWidth="70">
                        <ToolTip.Tip>
                            <TextBlock>
                                Only paths with this many or fewer characters will be returned.&#10;Use 999999 to not filter by maximum length.
                            </TextBlock>
                        </ToolTip.Tip>
                    </NumericUpDown>
                </Grid>

                <!-- Search Pattern row -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Search Pattern:" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Only file/directory names that match the given pattern will be returned. The * is a wildcard."/>
                    <TextBox x:Name="TxtSearchPattern" Text="{Binding SearchPattern}"
                             ToolTip.Tip="Only file/directory names that match the given pattern will be returned. The * is a wildcard."/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Row 2: Path Replacement Options -->
        <Border Grid.Row="2" Classes="groupBox">
            <StackPanel>
                <TextBlock Classes="groupBoxHeader" Text="Path Replacement Options"/>

                <!-- Replace root directory row -->
                <Grid ColumnDefinitions="Auto,5,*,40" Margin="0,0,0,4">
                    <CheckBox Grid.Column="0" Content="Replace the Starting Directory in the returned paths with:"
                              x:Name="ChkReplaceRootDirectory"
                              IsChecked="{Binding ReplaceRootDirectory}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="If this is not enabled, the Starting Directory will not be modified in the returned paths."/>
                    <TextBox Grid.Column="2" x:Name="TxtReplaceRootDirectory"
                             Text="{Binding RootDirectoryReplacement}"
                             IsEnabled="{Binding ReplaceRootDirectory}"
                             ToolTip.Tip="The path to replace the Starting Directory with in the paths that are returned."/>
                    <Button Grid.Column="3" Content="..."
                            x:Name="BtnBrowseForReplaceRootDirectory"
                            Click="BtnBrowseForReplaceRootDirectory_Click"
                            IsEnabled="{Binding ReplaceRootDirectory}"
                            ToolTip.Tip="Browse for a path to replace the Starting Directory path with."/>
                </Grid>

                <!-- URL encode row -->
                <CheckBox x:Name="ChkUrlEncodePaths"
                          Content="URL encode paths"
                          IsChecked="{Binding UrlEncodePaths}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="If enabled all paths will be URL (i.e. percent) encoded. e.g. Spaces will be replaced with %20, backslashes with %5C, etc."/>
            </StackPanel>
        </Border>

        <!-- Row 4: Action buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="10,*,10,100">
            <Button Grid.Column="1" Content="Get Path Lengths..."
                    x:Name="BtnGetPathLengths"
                    FontSize="40"
                    IsDefault="True"
                    IsVisible="{Binding !IsSearching}"
                    Click="BtnGetPathLengths_Click"/>
            <Button Grid.Column="1" Content="Cancel retrieving paths"
                    x:Name="BtnCancelGetPathLengths"
                    FontSize="40"
                    IsVisible="{Binding IsSearching}"
                    Click="BtnCancelGetPathLengths_Click"/>
            <Button Grid.Column="3" x:Name="BtnResetAllOptions"
                    Margin="0,10,0,10"
                    ToolTip.Tip="Reset all of the search and replacement fields to their default values."
                    Click="BtnResetAllOptions_Click">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="Reset all options"/>
            </Button>
        </Grid>

        <!-- Row 6: Results DataGrid -->
        <DataGrid Grid.Row="6"
                  x:Name="DgPaths"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  FontFamily="Courier New"
                  ItemsSource="{Binding Paths}"
                  SelectedItem="{Binding SelectedPath, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" SortMemberPath="Length" Width="80"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" SortMemberPath="Path" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open directory in File Explorer"
                              Click="MenuItem_OpenDirectoryInFileExplorer_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Row 8: Status text -->
        <TextBlock Grid.Row="8" x:Name="TxtNumberOfPaths" Text="{Binding NumberOfPathsText}"/>

        <!-- Row 10: Min/Max path lengths -->
        <TextBlock Grid.Row="10" x:Name="TxtMinAndMaxPathLengths" Text="{Binding MinAndMaxPathLengthsText}"/>

        <!-- Copy to clipboard split button (overlays rows 8-10, right-aligned) -->
        <StackPanel Grid.Row="8" Grid.RowSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <SplitButton x:Name="SplitBtnCopyToClipboard"
                         Content="Copy Paths to Clipboard"
                         Width="350"
                         Click="SplitBtnCopyToClipboard_Click">
                <SplitButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical" Width="345">
                            <Button x:Name="BtnCopyToClipboardWithoutLengths"
                                    Content="Copy Paths to Clipboard without Lengths"
                                    Click="BtnCopyToClipboardWithoutLengths_Click"/>
                            <Button x:Name="BtnCopyToClipboardAsCsv"
                                    Content="Copy Paths to Clipboard as CSV"
                                    Click="BtnCopyToClipboardAsCsv_Click"/>
                            <Button x:Name="BtnCopyToClipboardWithoutLengthsAsCsv"
                                    Content="Copy Paths to Clipboard without Lengths as CSV"
                                    Click="BtnCopyToClipboardWithoutLengthsAsCsv_Click"/>
                        </StackPanel>
                    </Flyout>
                </SplitButton.Flyout>
            </SplitButton>
        </StackPanel>

    </Grid>
</Window>
